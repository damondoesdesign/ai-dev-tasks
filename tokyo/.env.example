# --- Firebase (required for shared, multi-user data) ---------------------
# From Firebase console > Project settings > Your apps > Web app config.
# Leave these blank to run in LOCAL mode (single device, data in this browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Email of the first editor. The app lets this account create its own editor
# profile on first sign-in; every other account is created by an editor.
# Must match OWNER_EMAIL in firestore.rules.
VITE_OWNER_EMAIL=

# --- Google Places (place lookup: photos, hours, address, summary) --------
# Google Cloud console > APIs & Services > enable "Places API (New)",
# create an API key restricted to your site's HTTP referrers.
VITE_GOOGLE_PLACES_KEY=

# --- Map tiles ------------------------------------------------------------
# Either a .pmtiles file (served with HTTP range support, e.g. from this
# site's public/tiles folder) or a Protomaps API tile URL template.
# A .pmtiles URL is what makes the "Download map for offline" button work.
VITE_TILES_URL=/tiles/tokyo.pmtiles
# Optional: Protomaps API key if VITE_TILES_URL is an api.protomaps.com URL.
VITE_PROTOMAPS_KEY=

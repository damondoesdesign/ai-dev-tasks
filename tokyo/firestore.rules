rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Replace with the same address you put in VITE_OWNER_EMAIL.
    function ownerEmail() { return 'OWNER_EMAIL'; }

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isEditor() { return hasProfile() && profile().data.role == 'editor'; }
    function isOwner() { return signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == ownerEmail().lower(); }

    match /users/{uid} {
      // Everyone on the trip can see who's on it (names only matter in-app).
      allow read: if hasProfile() || (signedIn() && request.auth.uid == uid);
      // The owner bootstraps their own editor profile; editors add everyone else.
      allow create: if isEditor() || (isOwner() && request.auth.uid == uid);
      // Editors manage roles; anyone can change their own name and theme.
      allow update: if isEditor()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'theme']));
      allow delete: if isEditor() && request.auth.uid != uid;
    }

    match /trips/{trip} {
      allow read: if hasProfile();
      allow write: if isEditor();
      match /{document=**} {
        allow read: if hasProfile();
        allow write: if isEditor();
      }
    }
  }
}
